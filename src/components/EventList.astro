---
import { url } from '../data/site';
import { events, formatDate, type NatarajaEvent } from '../data/events';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list: NatarajaEvent[] = limit ? events.slice(0, limit) : events;
---

<ol class="events">
  {list.map((ev) => {
    const d = formatDate(ev.date);
    return (
      <li class="row" data-reveal>
        <div class="date">
          <span class="day">{d.day}</span>
          <span class="month">{d.month}</span>
        </div>
        <div class="info">
          <span class="kind">{ev.kind}</span>
          <h3>{ev.title}</h3>
          <p>{ev.description}</p>
        </div>
        <div class="meta">
          <span>{d.weekday} · {ev.time}</span>
          <span>{ev.place}</span>
        </div>
        <a class="btn btn-ghost" href={url(`/devis?sujet=${encodeURIComponent(ev.title)}`)}>Je m'inscris</a>
      </li>
    );
  })}
</ol>

<style>
  .events { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1.6fr) minmax(0, 1fr) auto;
    gap: 1.5rem 2rem;
    align-items: center;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s ease;
  }
  .row:hover { background: linear-gradient(90deg, rgb(255 159 28 / 0.06), transparent 70%); }
  .date { display: grid; line-height: 1; }
  .day {
    font-family: var(--display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 3.2rem;
    font-variant-numeric: tabular-nums;
  }
  .month { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--saffron); font-weight: 700; margin-top: 6px; }
  .info { display: grid; gap: 0.35rem; }
  .kind { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; color: var(--rani); }
  .info h3 { font-size: clamp(1.3rem, 2vw, 1.7rem); }
  .info p { color: var(--muted); font-size: 0.95rem; }
  .meta { display: grid; gap: 0.2rem; font-size: 0.92rem; color: var(--muted); }
  .meta span:first-child { color: var(--ivory); text-transform: capitalize; }
  @media (max-width: 900px) {
    .row { grid-template-columns: 80px minmax(0, 1fr); }
    .day { font-size: 2.4rem; }
    .meta, .row .btn { grid-column: 2; }
    .row .btn { justify-self: start; }
  }
</style>
